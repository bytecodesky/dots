{
    "layer": "top",
    "position": "bottom",
    "margin-bottom": 10,
    "mod": "dock",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "height": 44,
    "modules-left": [],
    "modules-center": [
        "temperature",
        "network",
        "battery",
        "clock"
    ],
    "modules-right": [],
    "temperature": {
        "thermal-zone": 0,
        "format": " {temperatureC}°C",
        "critical-threshold": 80,
        "format-critical": " {temperatureC}°C",
        "tooltip": false
    },
    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": "  Conectado",
        "format-disconnected": "󰤮  Sin Red",
        "tooltip-format": "{ifname} via {gwaddr}",
        "max-length": 25
    },
    "battery": {
        "interval": 10,
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 20
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ]
    },
    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "{:%Y-%m-%d}"
    }
}
